{
  "name": "Velora Mobile Workspace",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.vscode-pull-request-github",
        "MS-vsliveshare.vsliveshare"
      ],
      "settings": {
        "git.autofetch": true,
        "workbench.startupEditor": "readme",
        "editor.wordWrap": "on"
      }
    }
  },
  "remoteUser": "codespace"
}
